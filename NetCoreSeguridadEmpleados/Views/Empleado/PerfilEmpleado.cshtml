@using System.Security.Claims;

<h1>Bienvenido, @Context.User.FindFirst(ClaimTypes.Name).Value</h1>
<ul class="list-group">
    <li class="list-group-item">Oficio: @Context.User.FindFirst(ClaimTypes.Role).Value</li>
    <li class="list-group-item">Salario: @Context.User.FindFirst("Salario").Value</li>
    <li class="list-group-item">Departamento: @Context.User.FindFirst("Departamento").Value</li>
</ul>
<hr />
<h4>Todos los claims del usuario</h4>
<ul>
    @foreach(Claim claim in Context.User.Claims)
    {
        <li>@claim.Type: <b>@claim.Value</b></li>
    }
</ul>