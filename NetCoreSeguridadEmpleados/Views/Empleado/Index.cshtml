@model List<Empleado>
@section style{
    <style>
        table{
            width:70%;
            margin:auto;
            text-align:center
        }
    </style>
}
<h1>Empleados</h1>
<hr />
<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Apellido</th>
            <th>Oficio</th>
            <th>Salario</th>
            <th>Id Departamento</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach(Empleado empleado in Model)
        {
         <tr>
             <td>@empleado.IdEmpleado</td>
             <td>@empleado.Apellido</td>
             <td>@empleado.Oficio</td>
             <td>@empleado.Salario</td>
             <td>@empleado.IdDepartamento</td>
             <td>
                 <a asp-controller="Empleado" asp-action="Details" class="btn btn-outline-dark">Detalles</a>
             </td>
         </tr>   
        }
    </tbody>
</table>